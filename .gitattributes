# Normalize text files across Windows/Linux/macOS
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.rules text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

gradlew text eol=lf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.zip binary
*.apk binary